NOVACORE_APP_NAME=Novacore Platform
NOVACORE_ENVIRONMENT=development
NOVACORE_HOST=127.0.0.1
NOVACORE_PORT=8000
NOVACORE_LOG_LEVEL=info
NOVACORE_CORS_ORIGINS=http://localhost:3000

# Firestore uses Application Default Credentials. For local emulator use:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8089
GOOGLE_CLOUD_PROJECT=novacore-local

# Optional. The factory must be importable and return a configured Google ADK Agent.
# Example: my_project.agents:build_storyboard_agent
NOVACORE_ADK_APP_NAME=novacore
NOVACORE_ADK_SESSION_BACKEND=memory
NOVACORE_ADK_AGENT_FACTORY=my_project.agents:build_storyboard_agent
