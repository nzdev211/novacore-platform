# Novacore Platform server settings
NOVACORE_APP_NAME=Novacore Platform
NOVACORE_ENVIRONMENT=development
NOVACORE_HOST=127.0.0.1
NOVACORE_PORT=8000
NOVACORE_LOG_LEVEL=info

# Comma-separated browser origins. Keep empty until the frontend origin is known.
NOVACORE_CORS_ORIGINS=http://localhost:3000

